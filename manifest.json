{
  "manifest_version": 3,
  "name": "PalychGram — visual mod for Telegram Web",
  "version": "0.6.0",
  "description": "Темы, blur-privacy, твики удобства поверх web.telegram.org (WebK/WebZ). Только локально, без серверной магии.",
  "homepage_url": "https://web.telegram.org/",
  "browser_specific_settings": {
    "gecko": {
      "id": "palychgram@example.local"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "scripts": ["src/lib/compat.js", "src/background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://web.telegram.org/*"],
      "js": [
        "src/lib/compat.js",
        "src/lib/deleted-cache.js",
        "src/lib/premium-local.js",
        "src/lib/ghost.js",
        "src/lib/time-format.js",
        "src/lib/peer-id.js",
        "src/lib/snow.js",
        "src/lib/auto-pause.js",
        "src/lib/snippets.js",
        "src/lib/stats.js",
        "src/lib/export-chat.js",
        "src/content/palychgram.js"
      ],
      "css": ["src/content/themes.css", "src/content/privacy-blur.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "PalychGram",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "src/assets/icons/icon-48.png",
    "96": "src/assets/icons/icon-96.png"
  }
}
